{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shinydisc",
  "version": "0.1.0",
  "identifier": "com.edbaskerville.shinydisc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      // {
      //   "label": "brightwheel",
      //   "title": "brightwheel",
      //   "url": "https://schools.mybrightwheel.com",
      //   "width": 800,
      //   "height": 600
      // },
      {
        "label": "main",
        "title": "shinydisc",
        "width": 800,
        "height": 600,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
